# Server-only variables. Never prefix these with VITE_.
# Generate a password hash with: bun run hash:operator
# Paste the generated line into your ignored local .env; never commit its value.
OPERATOR_PASSWORD_HASH=

# Read-only Python API service token; configure locally after the backend runbook is complete.
SIREADER_API_AUTH_TOKEN=

# Optional sanitized BFF event logging. Does not enable request/header/body logging.
BFF_ENABLE_CONSOLE_LOGS=false
